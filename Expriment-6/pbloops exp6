#include <iostream>                        
 // Includes input/output functions
using namespace std;                        
// Uses the standard namespace

class Complex                              
// Defines a class named Complex
{
    float real, imag;                       
// Declares real and imaginary parts

public:
    void input()                            
// Function to take complex number input
    {
        cout << "Enter real part: ";        
// Asks for the real part
        cin >> real;                        
// Takes the real part from user

        cout << "Enter imaginary part: ";   
// Asks for the imaginary part
        cin >> imag;                        
// Takes the imaginary part from user
    }

    void operator*=(Complex c)              
// Overloads the *= operator
    {
        float r = real * c.real - imag * c.imag;  
// Calculates real part
        float i = real * c.imag + imag * c.real;  
// Calculates imaginary part

        real = r;                           
// Stores the new real part
        imag = i;                           
// Stores the new imaginary part
    }

    void display()                          
// Function to display complex number
    {
        cout << real << " + " << imag << "i";  
// Prints the complex number
    }
};

int main()                                  
// Main function
{
    Complex c1, c2;                         
// Creates two complex number objects

    cout << "Enter first complex number:\n"; 
// Asks for first complex number
    c1.input();                             
// Takes first complex number

    cout << "\nEnter second complex number:\n"; 
// Asks for second complex number
    c2.input();                             
// Takes second complex number

    c1 *= c2;                               
// Multiplies c1 by c2 using *=

    cout << "\nResult = ";                  
// Displays result message
    c1.display();                           
// Displays the final result

    return 0;                               
// Ends the program
}

