#include <iostream>
using namespace std;

class Complex
{
private:
    float r, i;

public:
   
    void read()
    {
        cout << "Enter real part: ";
        cin >> r;

        cout << "Enter imaginary part: ";
        cin >> i;
    }


    void reciprocal()
    {
        float denominator = (r * r) + (i * i);

        if (denominator == 0)
        {
            cout << "Reciprocal does not exist for 0 + 0i." << endl;
        }
        else
        {
            float realPart = r/ denominator;
            float imagPart = -i / denominator;

            cout << "Reciprocal = "
                 << realPart << " + ("
                 << imagPart << ")i" << endl;
        }
    }
};

int main()
{
    Complex c;

    c.read();
    c.reciprocal();

    return 0;
}


