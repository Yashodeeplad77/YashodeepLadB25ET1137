#include <iostream>
using namespace std;

// First namespace for arithmetic operations
namespace Arithmetic
{
    void show()
    {
        int a = 30, b = 50;
        cout << "Arithmetic namespace: "
             << a << " + " << b << " = " << a + b << endl;
    }
}

// Second namespace for geometry operations
namespace Geometry
{
    void show()
    {
        int length = 4, breadth = 2;
        cout << "Geometry namespace: rectangle area = "
             << length * breadth << endl;
    }
}

int main()
{
    // Calling functions using the scope resolution operator
    Arithmetic::show();
    Geometry::show();

    return 0;
}


output:-
Arithmetic namespace: 30 + 50 = 80
Geometry namespace: rectangle area = 8
